{
  "name": "@dvashim/typescript-config",
  "version": "5.0.6",
  "description": "Shared TypeScript configurations",
  "keywords": [
    "config",
    "shared-config",
    "tsconfig",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvashim/typescript-config.git"
  },
  "license": "MIT",
  "author": "Aleksei Reznichenko <aleksei@dvashim.dev>",
  "type": "module",
  "exports": {
    ".": "./dist/tsconfig.base.json",
    "./node": "./dist/tsconfig.node.json",
    "./lib-dev": "./dist/tsconfig.lib-dev.json",
    "./lib-prod": "./dist/tsconfig.lib-prod.json",
    "./app-react": "./dist/tsconfig.app-react.json",
    "./app-react-vite": "./dist/tsconfig.app-react-vite.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "biome format .",
    "check:publint": "publint --strict",
    "check:ts": "for f in ./tests/*.json; do tsc -p \"$f\" || exit 1; done"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@dvashim/biome-config": "^1.14.0",
    "@types/node": "^26.2.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "publishConfig": {
    "access": "public"
  }
}
