{
  "name": "@dvashim/typescript-config",
  "version": "5.0.11",
  "description": "Shared TypeScript configurations",
  "keywords": [
    "config",
    "shared-config",
    "tsconfig",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvashim/typescript-config.git"
  },
  "license": "MIT",
  "author": "Aleksei Reznichenko <aleksei@dvashim.dev>",
  "type": "module",
  "exports": {
    ".": "./dist/tsconfig.base.json",
    "./node": "./dist/tsconfig.node.json",
    "./lib-dev": "./dist/tsconfig.lib-dev.json",
    "./lib-prod": "./dist/tsconfig.lib-prod.json",
    "./app-react": "./dist/tsconfig.app-react.json",
    "./app-react-vite": "./dist/tsconfig.app-react-vite.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "biome format .",
    "check:publint": "publint --strict",
    "check:ts": "for f in ./tests/*.json; do tsc -p \"$f\" || exit 1; done"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@dvashim/biome-config": "^1.22.0",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "publishConfig": {
    "access": "public"
  }
}
