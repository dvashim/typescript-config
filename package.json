{
  "name": "@dvashim/typescript-config",
  "version": "4.0.6",
  "description": "Shared TypeScript configurations",
  "keywords": [
    "config",
    "shared-config",
    "tsconfig",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dvashim/typescript-config.git"
  },
  "license": "MIT",
  "author": "Aleksei Reznichenko <aleksei@dvashim.dev>",
  "type": "module",
  "exports": {
    ".": "./dist/tsconfig.base.json",
    "./node": "./dist/tsconfig.node.json",
    "./lib-dev": "./dist/tsconfig.lib-dev.json",
    "./lib-prod": "./dist/tsconfig.lib-prod.json",
    "./app-react": "./dist/tsconfig.app-react.json",
    "./app-react-vite": "./dist/tsconfig.app-react-vite.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm run \"/^check:.*/\"",
    "check:exports": "validate-package-exports --check",
    "check:format": "biome format .",
    "check:ts": "for f in ./tests/*.json; do tsc -p \"$f\" || exit 1; done"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@dvashim/biome-config": "^1.9.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "validate-package-exports": "^1.1.0",
    "vite": "^8.1.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "publishConfig": {
    "access": "public"
  }
}
